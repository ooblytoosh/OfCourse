# Copy this file to .env.local and fill in values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API (or "Connect").
# Never commit .env.local.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). The legacy "anon" key also works;
# you can set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this app, used in auth email links.
# Leave unset locally; set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# AI search (Phase 4). Server-side only: never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# OpenAI API key (platform.openai.com -> API keys).
OPENAI_API_KEY=

# Supabase service role key (Project Settings -> API Keys -> secret/service_role).
# Used only on the server to save post embeddings. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (defaults shown).
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-5.4-mini
