# Copy this file to .env.local and fill in values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API (or "Connect").
# Never commit .env.local.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). The legacy "anon" key also works;
# you can set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this app, used in auth email links.
# Leave unset locally; set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=
